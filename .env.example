# ─── Required ────────────────────────────────────────────────────────────────
#Agent Notarized Account
NOTARIZER_ADDRESS=account_tdx....

# Address of your deployed PolicyVault component
# Get this after deploying via the deploy page or SDK
POLICY_VAULT_ADDRESS=component_rdx1...

# Address of the agent badge resource
# Get this after deploying — it's the NFT the agent uses to authenticate
AGENT_BADGE_ADDRESS=resource_rdx1...

# Local ID of the agent badge NFT (default: #1#)
AGENT_BADGE_LOCAL_ID=#1#

# Network to connect to: mainnet | stokenet | localnet
NETWORK=mainnet 

# ─── Owner (optional — needed for multisig and badge management) ──────────────

#Owner Account
Owner_ADDRESS=account_tdx....

# Address of the owner badge resource
# Needed for: transfers above multisig threshold, badge management
OWNER_BADGE_ADDRESS=resource_rdx1...

# ─── AGGR (optional — needed for swaps and conditional orders) ────────────────

# AGGR endpoint — use Astrolescent or your own private instance
# Public:  https://api.astrolescent.com
# Private: http://your-server-ip:3001
AGGR_ENDPOINT=https://api.astrolescent.com

# You must to ask for a api for trading to @djtrebel on telegram or on astrolescent channel.  
# Your AGGR partner ID
AGGR_PARTNER_ID=XXXX

# AGGR request timeout in milliseconds (default: 5000)
AGGR_TIMEOUT_MS=5000
